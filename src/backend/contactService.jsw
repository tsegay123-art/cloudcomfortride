import wixData from 'wix-data';

const INQUIRIES_COLLECTION = 'ContactInquiries';

/**
 * Submit a contact/dispatch inquiry to Wix CMS 'ContactInquiries' collection.
 */
export async function submitInquiry(payload) {
  if (!payload || !String(payload.name || '').trim() || !String(payload.email || '').trim() || !String(payload.message || '').trim()) {
    return {
      success: false,
      message: 'Please fill in your name, email address, and message.'
    };
  }

  const email = String(payload.email).trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    return {
      success: false,
      message: 'Please provide a valid email address.'
    };
  }

  const inquiryId = `INQ-${Date.now()}`;
  const record = {
    inquiryId,
    name: String(payload.name).trim(),
    email: email.toLowerCase(),
    phone: String(payload.phone || '').trim(),
    subject: String(payload.subject || 'General Inquiry / Medical Transport').trim(),
    message: String(payload.message).trim(),
    createdAt: new Date().toISOString(),
    status: 'new'
  };

  let persistedToCms = false;
  try {
    await wixData.insert(INQUIRIES_COLLECTION, record, { suppressAuth: true });
    persistedToCms = true;
  } catch (err) {
    console.warn('ContactInquiries CMS insert skipped or unavailable:', err && err.message ? err.message : err);
  }

  return {
    success: true,
    persistedToCms,
    inquiry: record
  };
}

