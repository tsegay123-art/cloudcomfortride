import wixData from 'wix-data';
import { OWNER_EMAIL, sendWixOrResendNotification } from './notificationService';
import { verifyAdminAccess } from './authService.jsw';

const CONTACT_COLLECTION_CANDIDATES = ['ContactSubmissions', 'ContactMessages'];
let resolvedContactCollection = null;

async function resolveContactCollectionId() {
  if (resolvedContactCollection) return resolvedContactCollection;
  for (const name of CONTACT_COLLECTION_CANDIDATES) {
    try {
      await wixData.query(name).limit(1).find({ suppressAuth: true });
      resolvedContactCollection = name;
      return name;
    } catch (e) {
      // Try next candidate
    }
  }
  return 'ContactSubmissions';
}
const OWNER_CONTACT_SECRET = 'CCR_OWNER_CONTACT_EMAIL_ID';
const CUSTOMER_CONTACT_SECRET = 'CCR_CUSTOMER_CONTACT_EMAIL_ID';

async function verifyDispatchPin(pinOrToken) {
  const res = await verifyAdminAccess(pinOrToken);
  return Boolean(res && res.authorized);
}

/**
 * Submit a contact/dispatch inquiry to Wix CMS 'ContactMessages' collection.
 * Fails cleanly if CMS storage fails, and logs owner/customer notifications.
 */
export async function submitInquiry(payload) {
  if (payload && payload.website) {
    return {
      success: false,
      message: 'Submission rejected by spam protection.'
    };
  }

  const fullName = String((payload && payload.name) || '').trim();
  const email = String((payload && payload.email) || '').trim().toLowerCase();
  const phone = String((payload && payload.phone) || '').trim();
  const phoneDigits = phone.replace(/\D/g, '');
  const subject = String((payload && payload.subject) || 'General Inquiry / Medical Transport').trim();
  const message = String((payload && payload.message) || '').trim();

  if (!fullName || !email || !message) {
    return {
      success: false,
      message: 'Please fill in your full name, email address, and message.'
    };
  }

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    return {
      success: false,
      message: 'Please provide a valid email address.'
    };
  }

  if (phone && phoneDigits.length < 10) {
    return {
      success: false,
      message: 'Please provide a valid 10-digit telephone number.'
    };
  }

  const collectionId = await resolveContactCollectionId();

  // Duplicate submission guard (within last 5 minutes)
  try {
    const fiveMinAgo = new Date(Date.now() - 5 * 60 * 1000).toISOString();
    const existing = await wixData.query(collectionId)
      .eq('email', email)
      .eq('message', message)
      .ge('submissionDate', fiveMinAgo)
      .limit(1)
      .find({ suppressAuth: true });
    if (existing.items && existing.items.length > 0) {
      return {
        success: false,
        duplicate: true,
        message: `We already received this message (Reference: ${existing.items[0].messageReference}). Our team will reply shortly.`
      };
    }
  } catch (e) {
    // Proceed to insert
  }

  const nameParts = fullName.split(/\s+/);
  const firstName = nameParts[0] || fullName;
  const lastName = nameParts.slice(1).join(' ') || '-';
  const messageReference = `MSG-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`;
  const nowIso = new Date().toISOString();

  const record = {
    messageReference,
    inquiryId: messageReference,
    firstName,
    lastName,
    name: fullName,
    email,
    phone,
    subject,
    message,
    submissionDate: nowIso,
    createdAt: nowIso,
    messageStatus: 'NEW',
    status: 'NEW',
    notificationStatus: 'PENDING'
  };

  let insertedItem = null;
  try {
    insertedItem = await wixData.insert(collectionId, record, { suppressAuth: true });
  } catch (err) {
    console.error(`${collectionId} CMS insert failed:`, err && err.message ? err.message : err);
    return {
      success: false,
      persistedToCms: false,
      message: 'Unable to save your message to the dispatch database. Please call (206) 327-4411.'
    };
  }

  const vars = {
    inquiryId: messageReference,
    messageReference,
    name: fullName,
    email,
    phone: phone || 'Not provided',
    subject,
    message
  };

  const [ownerResult, customerResult] = await Promise.all([
    sendWixOrResendNotification({
      relatedRecordReference: messageReference,
      notificationType: 'OWNER_CONTACT_NOTIFICATION',
      recipientEmail: OWNER_EMAIL,
      recipientFirstName: 'Cloud Comfort Ride',
      recipientLastName: 'Dispatch',
      triggeredEmailSecretName: OWNER_CONTACT_SECRET,
      variables: vars,
      fallbackSubject: `New Contact Inquiry (${messageReference}) — ${fullName}`,
      fallbackHtml: `<p><strong>Ref:</strong> ${messageReference}</p><p><strong>From:</strong> ${fullName} (${email}, ${phone || 'No phone'})</p><p><strong>Topic:</strong> ${subject}</p><p>${message}</p>`
    }),
    sendWixOrResendNotification({
      relatedRecordReference: messageReference,
      notificationType: 'CUSTOMER_CONTACT_ACKNOWLEDGEMENT',
      recipientEmail: email,
      recipientFirstName: firstName,
      recipientLastName: lastName,
      recipientPhone: phone,
      triggeredEmailSecretName: CUSTOMER_CONTACT_SECRET,
      variables: vars,
      fallbackSubject: `We received your message (${messageReference}) — Cloud Comfort Ride`,
      fallbackHtml: `<p>Hi ${firstName},</p><p>Thank you for contacting Cloud Comfort Ride. Your inquiry reference is <strong>${messageReference}</strong>. Our Seattle team will respond shortly.</p>`
    })
  ]);

  const notificationStatus = ownerResult.delivered && customerResult.delivered
    ? 'SENT'
    : (ownerResult.delivered || customerResult.delivered ? 'PARTIAL' : 'FAILED');

  try {
    await wixData.update(collectionId, {
      ...insertedItem,
      notificationStatus
    }, { suppressAuth: true });
  } catch (e) {
    // Non-fatal
  }

  return {
    success: true,
    persistedToCms: true,
    ownerNotified: ownerResult.delivered,
    customerNotified: customerResult.delivered,
    notificationStatus,
    inquiry: {
      ...record,
      notificationStatus
    }
  };
}

export async function listAllInquiries(pin) {
  const ok = await verifyDispatchPin(pin);
  if (!ok) {
    return { success: false, message: 'Invalid Dispatch PIN.', items: [] };
  }
  const collectionId = await resolveContactCollectionId();
  try {
    const res = await wixData.query(collectionId)
      .descending('submissionDate')
      .limit(100)
      .find({ suppressAuth: true });
    return { success: true, items: res.items || [] };
  } catch (err) {
    return { success: false, items: [], message: 'ContactSubmissions / ContactMessages CMS collection not yet provisioned.' };
  }
}

export async function resolveInquiry(pin, messageReference) {
  const ok = await verifyDispatchPin(pin);
  if (!ok) {
    return { success: false, message: 'Invalid Dispatch PIN.' };
  }
  const collectionId = await resolveContactCollectionId();
  try {
    const res = await wixData.query(collectionId)
      .eq('messageReference', String(messageReference).trim())
      .limit(1)
      .find({ suppressAuth: true });
    if (!res.items || res.items.length === 0) {
      return { success: false, message: 'Inquiry not found.' };
    }
    const updated = {
      ...res.items[0],
      messageStatus: 'RESOLVED',
      status: 'RESOLVED',
      updatedAt: new Date().toISOString()
    };
    await wixData.update(collectionId, updated, { suppressAuth: true });
    return { success: true, inquiry: updated };
  } catch (err) {
    return { success: false, message: 'Unable to update inquiry.' };
  }
}
