import wixData from 'wix-data';
import { getSecret } from 'wix-secrets-backend';
import { COMPANY_INFO, getServiceTitle } from 'public/companyData';
import { sendWixOrResendNotification } from './notificationService';

const CANDIDATE_BOOKING_COLLECTIONS = ['Import1', 'Import_1', 'Import 1', 'Bookings'];
let cachedCollectionId = '';

const OWNER_EMAIL = COMPANY_INFO.email;
const OWNER_BOOKING_SECRET = 'CCR_OWNER_BOOKING_EMAIL_ID';
const CUSTOMER_BOOKING_SECRET = 'CCR_CUSTOMER_BOOKING_EMAIL_ID';

async function resolveBookingsCollectionId() {
  if (cachedCollectionId) return cachedCollectionId;
  for (const colId of CANDIDATE_BOOKING_COLLECTIONS) {
    try {
      await wixData.query(colId).limit(1).find({ suppressAuth: true });
      cachedCollectionId = colId;
      return colId;
    } catch (err) {
      // Try next candidate collection ID
    }
  }
  return '';
}

async function verifyDispatchPin(pin) {
  let expectedPin = '';
  try {
    expectedPin = await getSecret('CCR_DISPATCH_PIN');
  } catch (e) {
    expectedPin = '2023';
  }
  return Boolean(pin && String(pin).trim() === String(expectedPin).trim());
}

function validateServerBooking(data) {
  const errors = {};
  if (!data || typeof data !== 'object') {
    return { isValid: false, errors: { form: 'Invalid booking payload' } };
  }
  if (!data.serviceType) errors.serviceType = 'Service type is required';
  if (!data.firstName || !String(data.firstName).trim()) errors.firstName = 'First name is required';
  if (!data.lastName || !String(data.lastName).trim()) errors.lastName = 'Last name is required';

  const phoneDigits = String(data.phone || '').replace(/\D/g, '');
  if (phoneDigits.length < 10) errors.phone = 'Valid 10-digit telephone number is required';

  const email = String(data.email || '').trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.email = 'Valid email address is required';

  if (!data.pickupDate) {
    errors.pickupDate = 'Pickup date is required';
  } else {
    const todayStr = new Date().toISOString().split('T')[0];
    if (String(data.pickupDate) < todayStr) {
      errors.pickupDate = 'Pickup date cannot be in the past';
    }
  }
  if (!data.pickupTime) errors.pickupTime = 'Pickup time is required';
  if (data.tripType === 'round_trip' && !data.returnTime) {
    errors.returnTime = 'Return time is required for round trips';
  }
  if (!data.pickupAddress || !String(data.pickupAddress).trim()) {
    errors.pickupAddress = 'Pickup address is required';
  }
  if (!data.destinationAddress || !String(data.destinationAddress).trim()) {
    errors.destinationAddress = 'Destination address is required';
  }

  return {
    isValid: Object.keys(errors).length === 0,
    errors
  };
}

/**
 * Submit a new transportation booking request.
 * Resolves the active Wix CMS collection ('Import1' / 'Bookings'), saves all fields with status 'Pending',
 * and triggers owner/customer notifications.
 */
export async function submitBooking(payload) {
  if (payload && payload.website) {
    return {
      success: false,
      errors: { form: 'Submission rejected by spam protection.' },
      message: 'Submission rejected by spam protection.'
    };
  }

  const validation = validateServerBooking(payload);
  if (!validation.isValid) {
    return {
      success: false,
      errors: validation.errors,
      message: 'Please review the highlighted booking fields.'
    };
  }

  const collectionId = await resolveBookingsCollectionId();
  if (!collectionId) {
    return {
      success: false,
      persistedToCms: false,
      message: 'Booking CMS collection (Import 1 / Bookings) is not accessible. Please verify collection ID and permissions in Wix CMS.'
    };
  }

  const firstName = String(payload.firstName).trim();
  const lastName = String(payload.lastName).trim();
  const email = String(payload.email).trim().toLowerCase();
  const phone = String(payload.phone).trim();
  const pickupDate = String(payload.pickupDate);
  const pickupTime = String(payload.pickupTime);
  const destinationAddress = String(payload.destinationAddress).trim();
  const clientRequestId = String(payload.clientRequestId || '').trim();

  // Duplicate submission guard (within last 5 minutes)
  try {
    const fiveMinAgo = new Date(Date.now() - 5 * 60 * 1000).toISOString();
    const dupQuery = clientRequestId
      ? wixData.query(collectionId).eq('clientRequestId', clientRequestId)
      : wixData.query(collectionId)
        .eq('emailAddress', email)
        .eq('pickupDate', pickupDate)
        .eq('pickupTime', pickupTime)
        .eq('destinationAddress', destinationAddress)
        .ge('createdAt', fiveMinAgo);

    const existing = await dupQuery.limit(1).find({ suppressAuth: true });
    if (existing.items && existing.items.length > 0) {
      const ref = existing.items[0].bookingId || existing.items[0].bookingReference;
      return {
        success: false,
        duplicate: true,
        message: `A booking request for this trip was already received (Reference: ${ref}). View it in My Bookings.`
      };
    }
  } catch (e) {
    // Proceed to insert if field index/query isn't present yet
  }

  const randomSuffix = Math.floor(1000 + Math.random() * 9000);
  const bookingId = `CCR-${new Date().getFullYear()}-${randomSuffix}`;
  const nowIso = new Date().toISOString();
  const serviceTitle = getServiceTitle(String(payload.serviceType));
  const hasCompanion = Boolean(payload.hasCompanion ?? payload.companionRequired);
  const companionCount = hasCompanion ? Number(payload.companionCount || 1) : 0;

  const record = {
    bookingId,
    bookingReference: bookingId,
    createdAt: nowIso,
    updatedAt: nowIso,
    bookingStatus: 'Pending',
    serviceType: String(payload.serviceType),
    serviceTitle,
    vehicleOption: String(payload.vehiclePreference || payload.vehicleOption || 'best_match'),
    tripType: payload.tripType === 'one_way' ? 'one_way' : 'round_trip',
    pickupDate,
    pickupTime,
    estimatedReturnTime: payload.tripType === 'round_trip' ? String(payload.returnTime || '') : '',
    returnTime: payload.tripType === 'round_trip' ? String(payload.returnTime || '') : '',
    pickupAddress: String(payload.pickupAddress).trim(),
    pickupNotes: String(payload.pickupNotes || '').trim(),
    facilityName: String(payload.facilityName || '').trim(),
    destinationAddress,
    departmentSuite: String(payload.destinationNotes || payload.departmentSuite || '').trim(),
    passengerFirstName: firstName,
    passengerLastName: lastName,
    firstName,
    lastName,
    passengerName: `${firstName} ${lastName}`,
    contactPhone: phone,
    phone,
    emailAddress: email,
    email,
    mobilityRequirements: String(payload.mobilityNeed || payload.mobilityRequirements || 'ambulatory'),
    familyCompanion: hasCompanion,
    additionalPassengers: companionCount,
    hasStairs: Boolean(payload.hasStairs),
    specialInstructions: String(payload.specialInstructions || '').trim(),
    paymentPreference: String(payload.paymentPreference || '').trim(),
    customerNotes: String(payload.customerNotes || '').trim(),
    ownerNotes: '',
    notificationStatus: 'PENDING',
    clientRequestId
  };

  let insertedItem = null;
  try {
    insertedItem = await wixData.insert(collectionId, record, { suppressAuth: true });
  } catch (err) {
    const reason = err && err.message ? err.message : 'Unknown database error';
    console.error(`Wix CMS insert failed on '${collectionId}':`, reason);
    return {
      success: false,
      persistedToCms: false,
      message: `Unable to save booking to CMS (${collectionId}): ${reason}`
    };
  }

  const emailVars = {
    bookingId,
    bookingReference: bookingId,
    serviceTitle,
    vehicleOption: record.vehicleOption,
    tripType: record.tripType === 'round_trip' ? 'Round Trip' : 'One-Way',
    pickupDate: record.pickupDate,
    pickupTime: record.pickupTime,
    returnTime: record.estimatedReturnTime || 'N/A',
    pickupAddress: record.pickupAddress,
    pickupNotes: record.pickupNotes || 'None',
    facilityName: record.facilityName || 'N/A',
    destinationAddress: record.destinationAddress,
    department: record.departmentSuite || 'None',
    passengerName: record.passengerName,
    passengerPhone: record.contactPhone,
    passengerEmail: record.emailAddress,
    mobilityRequirement: record.mobilityRequirements,
    companionRequired: record.familyCompanion ? `Yes (${companionCount})` : 'No',
    specialInstructions: record.specialInstructions || 'None',
    bookingStatus: 'Pending'
  };

  const ownerHtml = `
    <h2>New Cloud Comfort Ride Booking Request (${bookingId})</h2>
    <p><strong>Status:</strong> Pending Owner Confirmation</p>
    <p><strong>Passenger:</strong> ${record.passengerName} | <strong>Phone:</strong> ${record.contactPhone} | <strong>Email:</strong> ${record.emailAddress}</p>
    <p><strong>Service:</strong> ${serviceTitle} (${emailVars.tripType}) | <strong>Vehicle:</strong> ${record.vehicleOption}</p>
    <p><strong>Pickup:</strong> ${record.pickupDate} at ${record.pickupTime} — ${record.pickupAddress} (Notes: ${emailVars.pickupNotes})</p>
    <p><strong>Destination:</strong> ${record.facilityName ? `${record.facilityName} — ` : ''}${record.destinationAddress} (${emailVars.department})</p>
    <p><strong>Mobility:</strong> ${record.mobilityRequirements} | <strong>Companion:</strong> ${emailVars.companionRequired}</p>
    <p><strong>Special Instructions:</strong> ${emailVars.specialInstructions}</p>
    <p>Manage &amp; Confirm in Owner Dispatch: https://www.cloudcomfortride.com/owner-dispatch</p>
  `;

  const customerHtml = `
    <h2>Your transportation request has been received successfully.</h2>
    <p>Dear ${firstName},</p>
    <p>Your Cloud Comfort Ride request (<strong>${bookingId}</strong>) has been saved and is currently <strong>Pending</strong> owner confirmation.</p>
    <p><strong>Requested Service:</strong> ${serviceTitle}<br/><strong>Pickup Date &amp; Time:</strong> ${record.pickupDate} at ${record.pickupTime}<br/><strong>Pickup:</strong> ${record.pickupAddress}<br/><strong>Destination:</strong> ${record.destinationAddress}</p>
    <p>Our team will review your request and send a confirmation once your driver is assigned. Your ride is not confirmed until you receive confirmation from Cloud Comfort Ride.</p>
  `;

  const [ownerResult, customerResult] = await Promise.all([
    sendWixOrResendNotification({
      relatedRecordReference: bookingId,
      notificationType: 'OWNER_BOOKING_NOTIFICATION',
      recipientEmail: OWNER_EMAIL,
      recipientFirstName: 'Cloud Comfort Ride',
      recipientLastName: 'Dispatch',
      triggeredEmailSecretName: OWNER_BOOKING_SECRET,
      variables: emailVars,
      fallbackSubject: `New Booking Request ${bookingId} — ${record.passengerName}`,
      fallbackHtml: ownerHtml
    }),
    sendWixOrResendNotification({
      relatedRecordReference: bookingId,
      notificationType: 'CUSTOMER_BOOKING_ACKNOWLEDGEMENT',
      recipientEmail: record.emailAddress,
      recipientFirstName: firstName,
      recipientLastName: lastName,
      recipientPhone: record.contactPhone,
      triggeredEmailSecretName: CUSTOMER_BOOKING_SECRET,
      variables: emailVars,
      fallbackSubject: `Cloud Comfort Ride Request Received (${bookingId})`,
      fallbackHtml: customerHtml
    })
  ]);

  const notificationStatus = ownerResult.delivered && customerResult.delivered
    ? 'SENT'
    : (ownerResult.delivered || customerResult.delivered ? 'PARTIAL' : 'FAILED');

  try {
    await wixData.update(collectionId, {
      ...insertedItem,
      notificationStatus,
      updatedAt: new Date().toISOString()
    }, { suppressAuth: true });
  } catch (e) {
    // Non-fatal update error
  }

  return {
    success: true,
    persistedToCms: true,
    collectionId,
    ownerNotified: ownerResult.delivered,
    customerNotified: customerResult.delivered,
    notificationStatus,
    booking: {
      ...record,
      id: bookingId,
      notificationStatus
    }
  };
}

/**
 * Verified customer booking lookup: requires BOTH bookingId/bookingReference AND matching email or phone.
 */
export async function lookupVerifiedBooking(bookingReference, verifier) {
  const ref = String(bookingReference || '').trim().toUpperCase();
  const check = String(verifier || '').trim();
  if (!ref || !check) {
    return {
      success: false,
      items: [],
      message: 'Please enter both your Booking Reference and your Email or Phone number.'
    };
  }

  const collectionId = await resolveBookingsCollectionId();
  if (!collectionId) {
    return { success: false, items: [], message: 'Booking database is unavailable right now.' };
  }

  try {
    const byId = wixData.query(collectionId).eq('bookingId', ref);
    const byRef = wixData.query(collectionId).eq('bookingReference', ref);
    const res = await byId.or(byRef).limit(5).find({ suppressAuth: true });

    const checkLower = check.toLowerCase();
    const checkDigits = check.replace(/\D/g, '');

    const matched = (res.items || []).filter((item) => {
      const itemEmail = String(item.emailAddress || item.email || item.passengerEmail || '').toLowerCase();
      const itemDigits = String(item.contactPhone || item.phone || item.passengerPhone || '').replace(/\D/g, '');
      const emailMatch = itemEmail && itemEmail === checkLower;
      const phoneMatch = checkDigits.length >= 4 && itemDigits && (itemDigits === checkDigits || itemDigits.endsWith(checkDigits));
      return emailMatch || phoneMatch;
    });

    if (!matched.length) {
      return {
        success: false,
        items: [],
        message: 'No booking matched that Reference and Email/Phone combination.'
      };
    }

    return { success: true, items: matched };
  } catch (err) {
    return {
      success: false,
      items: [],
      message: 'Unable to reach booking lookup service.'
    };
  }
}

/**
 * Cancel a verified booking from My Bookings.
 */
export async function cancelBooking(bookingReference, verifier = '') {
  const ref = String(bookingReference || '').trim().toUpperCase();
  if (!ref) return { success: false, message: 'Booking reference is required.' };

  const collectionId = await resolveBookingsCollectionId();
  if (!collectionId) return { success: false, message: 'Booking database unavailable.' };

  try {
    const res = await wixData.query(collectionId)
      .eq('bookingId', ref)
      .or(wixData.query(collectionId).eq('bookingReference', ref))
      .limit(1)
      .find({ suppressAuth: true });

    if (!res.items || !res.items.length) {
      return { success: false, message: 'Booking not found.' };
    }
    const item = res.items[0];
    if (verifier) {
      const vLower = String(verifier).trim().toLowerCase();
      const vDigits = String(verifier).replace(/\D/g, '');
      const emailMatch = String(item.emailAddress || item.email || item.passengerEmail || '').toLowerCase() === vLower;
      const phoneMatch = vDigits.length >= 4 && String(item.contactPhone || item.phone || item.passengerPhone || '').replace(/\D/g, '').endsWith(vDigits);
      if (!emailMatch && !phoneMatch) {
        return { success: false, message: 'Verification failed for this booking.' };
      }
    }

    await wixData.update(collectionId, {
      ...item,
      bookingStatus: 'Cancelled',
      status: 'Cancelled',
      updatedAt: new Date().toISOString()
    }, { suppressAuth: true });

    return { success: true, bookingReference: ref };
  } catch (err) {
    return { success: false, message: 'Unable to cancel booking in database.' };
  }
}

/**
 * Request confirmation follow-up from dispatch for a verified booking.
 */
export async function requestBookingConfirmation(bookingReference) {
  const ref = String(bookingReference || '').trim().toUpperCase();
  if (!ref) return { success: false, message: 'Booking Reference is required' };

  const notifyRes = await sendWixOrResendNotification({
    relatedRecordReference: ref,
    notificationType: 'OWNER_CONFIRMATION_FOLLOWUP',
    recipientEmail: OWNER_EMAIL,
    recipientFirstName: 'Cloud Comfort Ride',
    recipientLastName: 'Dispatch',
    triggeredEmailSecretName: OWNER_BOOKING_SECRET,
    variables: {
      bookingId: ref,
      bookingReference: ref,
      serviceTitle: 'Confirmation Follow-Up Requested by Passenger',
      specialInstructions: `Passenger requested confirmation update for booking ${ref} via My Bookings.`
    },
    fallbackSubject: `Confirmation Follow-Up Requested: ${ref}`,
    fallbackHtml: `<p>Passenger requested an immediate confirmation update for booking <strong>${ref}</strong>.</p>`
  });

  return { success: true, bookingReference: ref, ownerNotified: notifyRes.delivered };
}

/**
 * Owner Dispatch: list all bookings from the active Wix CMS collection.
 */
export async function listAllBookings(pin) {
  const ok = await verifyDispatchPin(pin);
  if (!ok) {
    return { success: false, message: 'Invalid Dispatch PIN.', items: [] };
  }

  const collectionId = await resolveBookingsCollectionId();
  if (!collectionId) {
    return { success: false, items: [], message: 'Bookings CMS collection (Import 1 / Bookings) not found.' };
  }

  try {
    const res = await wixData.query(collectionId)
      .descending('createdAt')
      .limit(100)
      .find({ suppressAuth: true });
    return { success: true, collectionId, items: res.items || [] };
  } catch (err) {
    const resFallback = await wixData.query(collectionId).limit(100).find({ suppressAuth: true });
    return { success: true, collectionId, items: resFallback.items || [] };
  }
}

/**
 * Owner Dispatch: update booking status ('CONFIRMED', 'REJECTED', 'CANCELLED', 'COMPLETED', 'PENDING') + ownerNotes.
 */
export async function updateBookingStatus(pin, bookingReference, nextStatus, ownerNotes = '') {
  const ok = await verifyDispatchPin(pin);
  if (!ok) {
    return { success: false, message: 'Invalid Dispatch PIN.' };
  }

  const normalized = String(nextStatus || '').toUpperCase();
  const allowed = ['CONFIRMED', 'REJECTED', 'CANCELLED', 'COMPLETED', 'PENDING'];
  if (!allowed.includes(normalized)) {
    return { success: false, message: 'Invalid booking status.' };
  }

  const collectionId = await resolveBookingsCollectionId();
  if (!collectionId) {
    return { success: false, message: 'Booking collection not found.' };
  }

  try {
    const ref = String(bookingReference).trim();
    const res = await wixData.query(collectionId)
      .eq('bookingId', ref)
      .or(wixData.query(collectionId).eq('bookingReference', ref))
      .limit(1)
      .find({ suppressAuth: true });

    if (!res.items || res.items.length === 0) {
      return { success: false, message: 'Booking not found in CMS.' };
    }

    const current = res.items[0];
    const updated = {
      ...current,
      bookingStatus: normalized,
      status: normalized,
      ownerNotes: ownerNotes !== undefined ? String(ownerNotes).trim() : (current.ownerNotes || ''),
      updatedAt: new Date().toISOString()
    };
    await wixData.update(collectionId, updated, { suppressAuth: true });

    const customerEmail = updated.emailAddress || updated.email || updated.passengerEmail;
    const refOut = updated.bookingId || updated.bookingReference;
    if ((normalized === 'CONFIRMED' || normalized === 'REJECTED') && customerEmail) {
      await sendWixOrResendNotification({
        relatedRecordReference: refOut,
        notificationType: `CUSTOMER_STATUS_${normalized}`,
        recipientEmail: customerEmail,
        recipientFirstName: updated.passengerFirstName || updated.firstName || 'Passenger',
        recipientLastName: updated.passengerLastName || updated.lastName || '',
        triggeredEmailSecretName: CUSTOMER_BOOKING_SECRET,
        variables: {
          bookingId: refOut,
          bookingReference: refOut,
          serviceTitle: updated.serviceTitle || getServiceTitle(updated.serviceType),
          pickupDate: updated.pickupDate,
          pickupTime: updated.pickupTime,
          pickupAddress: updated.pickupAddress,
          destinationAddress: updated.destinationAddress,
          passengerName: updated.passengerName || `${updated.passengerFirstName || ''} ${updated.passengerLastName || ''}`.trim(),
          bookingStatus: normalized,
          specialInstructions: `Status: ${normalized}${updated.ownerNotes ? ` — ${updated.ownerNotes}` : ''}`
        },
        fallbackSubject: `Cloud Comfort Ride Booking ${normalized} (${refOut})`,
        fallbackHtml: `<p>Your Cloud Comfort Ride booking <strong>${refOut}</strong> is now <strong>${normalized}</strong>.</p><p>${updated.ownerNotes || ''}</p>`
      });
    }

    return { success: true, booking: updated };
  } catch (err) {
    return { success: false, message: 'Unable to update booking status.' };
  }
}
