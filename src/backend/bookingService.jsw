import wixData from 'wix-data';
import { getSecret } from 'wix-secrets-backend';
import { getServiceTitle } from 'public/companyData';
import { OWNER_EMAIL, sendWixOrResendNotification } from './notificationService';

const BOOKINGS_COLLECTION = 'Bookings';
const OWNER_EMAIL_TEMPLATE_ID = 'booking_owner_notification';
const CUSTOMER_EMAIL_TEMPLATE_ID = 'booking_customer_confirmation';

async function verifyDispatchPin(pin) {
  let expectedPin = '';
  try {
    expectedPin = await getSecret('CCR_DISPATCH_PIN');
  } catch (e) {
    expectedPin = '2023';
  }
  return Boolean(pin && String(pin).trim() === String(expectedPin).trim());
}

function validateServerBooking(data) {
  const errors = {};
  if (!data || typeof data !== 'object') {
    return { isValid: false, errors: { form: 'Invalid booking payload' } };
  }
  if (!data.serviceType) errors.serviceType = 'Service type is required';
  if (!data.firstName || !String(data.firstName).trim()) errors.firstName = 'First name is required';
  if (!data.lastName || !String(data.lastName).trim()) errors.lastName = 'Last name is required';

  const phoneDigits = String(data.phone || '').replace(/\D/g, '');
  if (phoneDigits.length < 10) errors.phone = 'Valid 10-digit telephone number is required';

  const email = String(data.email || '').trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.email = 'Valid email address is required';

  if (!data.pickupDate) errors.pickupDate = 'Pickup date is required';
  if (!data.pickupTime) errors.pickupTime = 'Pickup time is required';
  if (data.tripType === 'round_trip' && !data.returnTime) {
    errors.returnTime = 'Return time is required for round trips';
  }
  if (!data.pickupAddress || !String(data.pickupAddress).trim()) {
    errors.pickupAddress = 'Pickup address is required';
  }
  if (!data.destinationAddress || !String(data.destinationAddress).trim()) {
    errors.destinationAddress = 'Destination address is required';
  }

  return {
    isValid: Object.keys(errors).length === 0,
    errors
  };
}

/**
 * Submit a new transportation booking request.
 * Stores in Wix CMS 'Bookings' with status PENDING and logs owner/customer notifications.
 */
export async function submitBooking(payload) {
  if (payload && payload.website) {
    return {
      success: false,
      errors: { form: 'Submission rejected by spam protection.' },
      message: 'Submission rejected by spam protection.'
    };
  }

  const validation = validateServerBooking(payload);
  if (!validation.isValid) {
    return {
      success: false,
      errors: validation.errors,
      message: 'Please review the highlighted booking fields.'
    };
  }

  const firstName = String(payload.firstName).trim();
  const lastName = String(payload.lastName).trim();
  const email = String(payload.email).trim().toLowerCase();
  const phone = String(payload.phone).trim();
  const pickupDate = String(payload.pickupDate);
  const pickupTime = String(payload.pickupTime);
  const destinationAddress = String(payload.destinationAddress).trim();
  const clientRequestId = String(payload.clientRequestId || '').trim();

  // Duplicate submission guard (within last 5 minutes)
  try {
    const fiveMinAgo = new Date(Date.now() - 5 * 60 * 1000).toISOString();
    const dupQuery = clientRequestId
      ? wixData.query(BOOKINGS_COLLECTION).eq('clientRequestId', clientRequestId)
      : wixData.query(BOOKINGS_COLLECTION)
        .eq('email', email)
        .eq('pickupDate', pickupDate)
        .eq('pickupTime', pickupTime)
        .eq('destinationAddress', destinationAddress)
        .ge('submissionDate', fiveMinAgo);

    const existing = await dupQuery.limit(1).find({ suppressAuth: true });
    if (existing.items && existing.items.length > 0) {
      const ref = existing.items[0].bookingReference || existing.items[0].bookingId;
      return {
        success: false,
        duplicate: true,
        message: `A booking request for this trip was already received (Reference: ${ref}). View it in My Bookings or call (206) 327-4411.`
      };
    }
  } catch (e) {
    // Proceed to insert; insert itself will fail cleanly if Bookings collection does not exist
  }

  const randomSuffix = Math.floor(1000 + Math.random() * 9000);
  const bookingReference = `CCR-${new Date().getFullYear()}-${randomSuffix}`;
  const nowIso = new Date().toISOString();
  const serviceTitle = getServiceTitle(String(payload.serviceType));

  const record = {
    bookingReference,
    bookingId: bookingReference,
    id: bookingReference,
    clientRequestId,
    submissionDate: nowIso,
    createdAt: nowIso,
    bookingStatus: 'PENDING',
    status: 'PENDING',
    firstName,
    lastName,
    passengerName: `${firstName} ${lastName}`,
    email,
    passengerEmail: email,
    phone,
    passengerPhone: phone,
    serviceType: String(payload.serviceType),
    serviceTitle,
    vehiclePreference: String(payload.vehiclePreference || 'best_match'),
    tripType: payload.tripType === 'one_way' ? 'one_way' : 'round_trip',
    pickupDate,
    pickupTime,
    returnTime: payload.tripType === 'round_trip' ? String(payload.returnTime || '') : '',
    pickupAddress: String(payload.pickupAddress).trim(),
    pickupNotes: String(payload.pickupNotes || '').trim(),
    facilityName: String(payload.facilityName || '').trim(),
    destinationAddress,
    department: String(payload.destinationNotes || '').trim(),
    destinationNotes: String(payload.destinationNotes || '').trim(),
    mobilityRequirement: String(payload.mobilityNeed || 'ambulatory'),
    mobilityNeed: String(payload.mobilityNeed || 'ambulatory'),
    companionRequired: Boolean(payload.hasCompanion),
    hasCompanion: Boolean(payload.hasCompanion),
    companionCount: payload.hasCompanion ? Number(payload.companionCount || 1) : 0,
    hasStairs: Boolean(payload.hasStairs),
    specialInstructions: String(payload.specialInstructions || '').trim(),
    ownerNotes: '',
    notificationStatus: 'PENDING'
  };

  let insertedItem = null;
  try {
    insertedItem = await wixData.insert(BOOKINGS_COLLECTION, record, { suppressAuth: true });
  } catch (err) {
    console.error('Bookings CMS insert failed:', err && err.message ? err.message : err);
    return {
      success: false,
      persistedToCms: false,
      message: 'Unable to store your booking in the dispatch database. Please call (206) 327-4411 so we can assist you immediately.'
    };
  }

  const emailVars = {
    bookingId: bookingReference,
    bookingReference,
    serviceTitle,
    vehiclePreference: record.vehiclePreference,
    tripType: record.tripType === 'round_trip' ? 'Round Trip' : 'One-Way',
    pickupDate: record.pickupDate,
    pickupTime: record.pickupTime,
    returnTime: record.returnTime || 'N/A',
    pickupAddress: record.pickupAddress,
    pickupNotes: record.pickupNotes || 'None',
    facilityName: record.facilityName || 'N/A',
    destinationAddress: record.destinationAddress,
    destinationNotes: record.department || 'None',
    passengerName: record.passengerName,
    passengerPhone: record.phone,
    passengerEmail: record.email,
    mobilityNeed: record.mobilityRequirement,
    companions: record.hasCompanion ? String(record.companionCount) : '0',
    stairs: record.hasStairs ? 'Yes' : 'No',
    specialInstructions: record.specialInstructions || 'None',
    bookingStatus: 'PENDING'
  };

  const ownerHtml = `
    <h2>New Cloud Comfort Ride Booking Request (${bookingReference})</h2>
    <p><strong>Status:</strong> PENDING CONFIRMATION</p>
    <p><strong>Passenger:</strong> ${record.passengerName} | <strong>Phone:</strong> ${record.phone} | <strong>Email:</strong> ${record.email}</p>
    <p><strong>Service:</strong> ${serviceTitle} (${emailVars.tripType}) | <strong>Vehicle:</strong> ${record.vehiclePreference}</p>
    <p><strong>Pickup:</strong> ${record.pickupDate} at ${record.pickupTime} — ${record.pickupAddress} (Notes: ${emailVars.pickupNotes})</p>
    <p><strong>Destination:</strong> ${record.facilityName ? `${record.facilityName} — ` : ''}${record.destinationAddress} (${emailVars.destinationNotes})</p>
    <p><strong>Mobility:</strong> ${record.mobilityRequirement} | <strong>Companions:</strong> ${emailVars.companions} | <strong>Stairs:</strong> ${emailVars.stairs}</p>
    <p><strong>Special Instructions:</strong> ${emailVars.specialInstructions}</p>
    <p>Manage &amp; Confirm in Owner Dispatch: https://www.cloudcomfortride.com/owner-dispatch</p>
  `;

  const customerHtml = `
    <h2>Thank you for your ride request, ${firstName}!</h2>
    <p>Your Cloud Comfort Ride booking request (<strong>${bookingReference}</strong>) has been received and is currently <strong>PENDING</strong> dispatch confirmation.</p>
    <p><strong>Service:</strong> ${serviceTitle}<br/><strong>Pickup:</strong> ${record.pickupDate} at ${record.pickupTime} from ${record.pickupAddress}<br/><strong>Destination:</strong> ${record.destinationAddress}</p>
    <p>Our Seattle dispatch team will contact you shortly to confirm your vehicle assignment. For immediate updates, call (206) 327-4411.</p>
  `;

  const [ownerResult, customerResult] = await Promise.all([
    sendWixOrResendNotification({
      relatedRecordReference: bookingReference,
      notificationType: 'OWNER_BOOKING_NOTIFICATION',
      recipientEmail: OWNER_EMAIL,
      recipientFirstName: 'Cloud Comfort Ride',
      recipientLastName: 'Dispatch',
      triggeredEmailId: OWNER_EMAIL_TEMPLATE_ID,
      variables: emailVars,
      fallbackSubject: `New Booking Request ${bookingReference} — ${record.passengerName}`,
      fallbackHtml: ownerHtml
    }),
    sendWixOrResendNotification({
      relatedRecordReference: bookingReference,
      notificationType: 'CUSTOMER_BOOKING_ACKNOWLEDGEMENT',
      recipientEmail: record.email,
      recipientFirstName: firstName,
      recipientLastName: lastName,
      recipientPhone: record.phone,
      triggeredEmailId: CUSTOMER_EMAIL_TEMPLATE_ID,
      variables: emailVars,
      fallbackSubject: `Cloud Comfort Ride Request Received (${bookingReference})`,
      fallbackHtml: customerHtml
    })
  ]);

  const notificationStatus = ownerResult.delivered && customerResult.delivered
    ? 'SENT'
    : (ownerResult.delivered || customerResult.delivered ? 'PARTIAL' : 'FAILED');

  try {
    await wixData.update(BOOKINGS_COLLECTION, {
      ...insertedItem,
      notificationStatus
    }, { suppressAuth: true });
  } catch (e) {
    // Non-fatal update error
  }

  return {
    success: true,
    persistedToCms: true,
    ownerNotified: ownerResult.delivered,
    customerNotified: customerResult.delivered,
    notificationStatus,
    booking: {
      ...record,
      notificationStatus
    }
  };
}

/**
 * Verified customer booking lookup: requires BOTH bookingReference AND matching email or phone.
 */
export async function lookupVerifiedBooking(bookingReference, verifier) {
  const ref = String(bookingReference || '').trim().toUpperCase();
  const check = String(verifier || '').trim();
  if (!ref || !check) {
    return {
      success: false,
      items: [],
      message: 'Please enter both your Booking Reference and your Email or Phone number.'
    };
  }

  try {
    const res = await wixData.query(BOOKINGS_COLLECTION)
      .eq('bookingReference', ref)
      .limit(5)
      .find({ suppressAuth: true });

    const checkLower = check.toLowerCase();
    const checkDigits = check.replace(/\D/g, '');

    const matched = (res.items || []).filter((item) => {
      const itemEmail = String(item.email || item.passengerEmail || '').toLowerCase();
      const itemDigits = String(item.phone || item.passengerPhone || '').replace(/\D/g, '');
      const emailMatch = itemEmail && itemEmail === checkLower;
      const phoneMatch = checkDigits.length >= 4 && itemDigits && (itemDigits === checkDigits || itemDigits.endsWith(checkDigits));
      return emailMatch || phoneMatch;
    });

    if (!matched.length) {
      return {
        success: false,
        items: [],
        message: 'No booking matched that Reference and Email/Phone combination.'
      };
    }

    return { success: true, items: matched };
  } catch (err) {
    return {
      success: false,
      items: [],
      message: 'Unable to reach booking lookup service. Please call (206) 327-4411.'
    };
  }
}

/**
 * Cancel a verified booking from My Bookings.
 */
export async function cancelBooking(bookingReference, verifier = '') {
  const ref = String(bookingReference || '').trim().toUpperCase();
  if (!ref) return { success: false, message: 'Booking reference is required.' };

  try {
    const res = await wixData.query(BOOKINGS_COLLECTION)
      .eq('bookingReference', ref)
      .limit(1)
      .find({ suppressAuth: true });

    if (!res.items || !res.items.length) {
      return { success: false, message: 'Booking not found.' };
    }
    const item = res.items[0];
    if (verifier) {
      const vLower = String(verifier).trim().toLowerCase();
      const vDigits = String(verifier).replace(/\D/g, '');
      const emailMatch = String(item.email || item.passengerEmail || '').toLowerCase() === vLower;
      const phoneMatch = vDigits.length >= 4 && String(item.phone || item.passengerPhone || '').replace(/\D/g, '').endsWith(vDigits);
      if (!emailMatch && !phoneMatch) {
        return { success: false, message: 'Verification failed for this booking.' };
      }
    }

    await wixData.update(BOOKINGS_COLLECTION, {
      ...item,
      bookingStatus: 'CANCELLED',
      status: 'CANCELLED',
      updatedAt: new Date().toISOString()
    }, { suppressAuth: true });

    return { success: true, bookingReference: ref };
  } catch (err) {
    return { success: false, message: 'Unable to cancel booking in database.' };
  }
}

/**
 * Request confirmation follow-up from dispatch for a verified booking.
 */
export async function requestBookingConfirmation(bookingReference) {
  const ref = String(bookingReference || '').trim().toUpperCase();
  if (!ref) return { success: false, message: 'Booking Reference is required' };

  const notifyRes = await sendWixOrResendNotification({
    relatedRecordReference: ref,
    notificationType: 'OWNER_CONFIRMATION_FOLLOWUP',
    recipientEmail: OWNER_EMAIL,
    recipientFirstName: 'Cloud Comfort Ride',
    recipientLastName: 'Dispatch',
    triggeredEmailId: OWNER_EMAIL_TEMPLATE_ID,
    variables: {
      bookingId: ref,
      bookingReference: ref,
      serviceTitle: 'Confirmation Follow-Up Requested by Passenger',
      specialInstructions: `Passenger requested confirmation update for booking ${ref} via My Bookings.`
    },
    fallbackSubject: `Confirmation Follow-Up Requested: ${ref}`,
    fallbackHtml: `<p>Passenger requested an immediate confirmation update for booking <strong>${ref}</strong>.</p>`
  });

  return { success: true, bookingReference: ref, ownerNotified: notifyRes.delivered };
}

/**
 * Owner Dispatch: list all bookings from Wix CMS 'Bookings' collection.
 */
export async function listAllBookings(pin) {
  const ok = await verifyDispatchPin(pin);
  if (!ok) {
    return { success: false, message: 'Invalid Dispatch PIN.', items: [] };
  }

  try {
    const res = await wixData.query(BOOKINGS_COLLECTION)
      .descending('submissionDate')
      .limit(100)
      .find({ suppressAuth: true });
    return { success: true, items: res.items || [] };
  } catch (err) {
    return { success: false, items: [], message: 'Bookings CMS collection not yet provisioned.' };
  }
}

/**
 * Owner Dispatch: update booking status ('CONFIRMED', 'REJECTED', 'CANCELLED', 'PENDING') + ownerNotes.
 */
export async function updateBookingStatus(pin, bookingReference, nextStatus, ownerNotes = '') {
  const ok = await verifyDispatchPin(pin);
  if (!ok) {
    return { success: false, message: 'Invalid Dispatch PIN.' };
  }

  const normalized = String(nextStatus || '').toUpperCase();
  const allowed = ['CONFIRMED', 'REJECTED', 'CANCELLED', 'PENDING'];
  if (!allowed.includes(normalized)) {
    return { success: false, message: 'Invalid booking status.' };
  }

  try {
    const res = await wixData.query(BOOKINGS_COLLECTION)
      .eq('bookingReference', String(bookingReference).trim())
      .limit(1)
      .find({ suppressAuth: true });

    if (!res.items || res.items.length === 0) {
      return { success: false, message: 'Booking not found in CMS.' };
    }

    const current = res.items[0];
    const updated = {
      ...current,
      bookingStatus: normalized,
      status: normalized,
      ownerNotes: ownerNotes !== undefined ? String(ownerNotes).trim() : (current.ownerNotes || ''),
      updatedAt: new Date().toISOString()
    };
    await wixData.update(BOOKINGS_COLLECTION, updated, { suppressAuth: true });

    const customerEmail = updated.email || updated.passengerEmail;
    if ((normalized === 'CONFIRMED' || normalized === 'REJECTED') && customerEmail) {
      await sendWixOrResendNotification({
        relatedRecordReference: updated.bookingReference,
        notificationType: `CUSTOMER_STATUS_${normalized}`,
        recipientEmail: customerEmail,
        recipientFirstName: updated.firstName || 'Passenger',
        recipientLastName: updated.lastName || '',
        triggeredEmailId: CUSTOMER_EMAIL_TEMPLATE_ID,
        variables: {
          bookingId: updated.bookingReference,
          bookingReference: updated.bookingReference,
          serviceTitle: updated.serviceTitle || getServiceTitle(updated.serviceType),
          pickupDate: updated.pickupDate,
          pickupTime: updated.pickupTime,
          pickupAddress: updated.pickupAddress,
          destinationAddress: updated.destinationAddress,
          passengerName: updated.passengerName,
          bookingStatus: normalized,
          specialInstructions: `Status: ${normalized}${updated.ownerNotes ? ` — ${updated.ownerNotes}` : ''}`
        },
        fallbackSubject: `Cloud Comfort Ride Booking ${normalized} (${updated.bookingReference})`,
        fallbackHtml: `<p>Your Cloud Comfort Ride booking <strong>${updated.bookingReference}</strong> is now <strong>${normalized}</strong>.</p><p>${updated.ownerNotes || ''}</p>`
      });
    }

    return { success: true, booking: updated };
  } catch (err) {
    return { success: false, message: 'Unable to update booking status.' };
  }
}
